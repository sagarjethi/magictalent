# ─── Jobmagic environment ─── copy to .env.local; never commit real secrets.
# All AI features degrade to deterministic heuristics when these are unset.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
# Optional: raises GitHub source rate limits + result quality. Degrades to a public sample without it.
GITHUB_TOKEN=
# Local DB file (falls back to in-memory if better-sqlite3 is unavailable)
DATABASE_URL=file:./data/jobmagic.db
# Gated sources — OFF by default for legal reasons.
ENABLE_LINKEDIN_SOURCING=false
ENABLE_NAUKRI_SOURCING=false

# Point the frontend at the NestJS backend (jobmagic-api). Unset = use built-in Next API routes.
NEXT_PUBLIC_API_BASE=

# Secret used to sign auth JWTs (HS256). Change in production.
AUTH_SECRET=jobmagic-dev-secret-change-me
