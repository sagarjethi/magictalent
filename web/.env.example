# ─── Jobmagic environment ─── copy to .env.local; never commit real secrets.
# All AI features degrade to deterministic heuristics when no provider key is set.
#
# ── AI provider (fully configurable; pick ONE, or leave auto) ──
# AI_PROVIDER: xai | grok | anthropic | claude | none | auto (default: auto = use whichever key is set, xAI first)
AI_PROVIDER=auto
# xAI / Grok (OpenAI-compatible). This is the recommended provider.
XAI_API_KEY=
XAI_MODEL=grok-4
# XAI_BASE_URL=https://api.x.ai/v1
# Anthropic (alternative provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Generic model override (applies to whichever provider is active; provider-specific vars win)
# AI_MODEL=
# Optional hard cap on tokens per request
# AI_MAX_TOKENS=
# Optional: raises GitHub source rate limits + result quality. Degrades to a public sample without it.
GITHUB_TOKEN=
# Local DB file (falls back to in-memory if better-sqlite3 is unavailable)
DATABASE_URL=file:./data/jobmagic.db
# Gated sources — OFF by default for legal reasons.
ENABLE_LINKEDIN_SOURCING=false
ENABLE_NAUKRI_SOURCING=false

# Point the frontend at the NestJS backend (jobmagic-api). Unset = use built-in Next API routes.
NEXT_PUBLIC_API_BASE=

# Public app URL used to build candidate video-interview join links (room URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional invite delivery providers (unset = invites are composed + simulated, never blocking) ──
# Email: set one. SMS: set both Twilio vars.
RESEND_API_KEY=
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Secret used to sign auth JWTs (HS256). Change in production.
AUTH_SECRET=jobmagic-dev-secret-change-me
