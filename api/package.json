{
  "name": "jobmagic-api",
  "version": "0.1.0",
  "private": true,
  "description": "Jobmagic API — standalone NestJS backend hosting the shared matching brain, source pipeline, LangGraph agents and REST API (graceful degradation, no key required).",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@langchain/anthropic": "^0.3.11",
    "@langchain/core": "^0.3.27",
    "@langchain/langgraph": "^0.2.39",
    "@langchain/openai": "^0.3.17",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "better-sqlite3": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
