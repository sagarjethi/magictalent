# Jobmagic API configuration. All values are OPTIONAL — the service runs fully in
# heuristic mode with none of these set (graceful degradation).

# Anthropic API key. When set, AI features and the LangGraph agents use Claude.
# When unset, every feature falls back to a deterministic heuristic (mode:'heuristic').
ANTHROPIC_API_KEY=

# Override the model id (default: claude-sonnet-4-6).
AI_MODEL=claude-sonnet-4-6

# GitHub token. When set, the github source adapter queries the live Search API.
# When unset, it degrades to a built-in offline sample of github-style candidates.
GITHUB_TOKEN=

# HTTP port the API listens on.
PORT=4000

# Allowed CORS origin(s) for the Next.js frontend. Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:3000
